    "label-m": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": "{weight.medium}",
        "letterSpacing": {
          "value": -0.075,
          "unit": "px"
        },
        "lineHeight": 1.2
      },
