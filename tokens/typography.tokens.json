        }
      }
    },
    "body-s": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": 0.026,
          "unit": "px"
        },
        "lineHeight": 1.45
      },
