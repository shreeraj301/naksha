        },
        {
          "family": "Newsreader",
          "file": "fonts/Newsreader-Variable.woff2",
          "weight": "200 800"
        },
        {
          "family": "Newsreader",
          "file": "fonts/Newsreader-Italic-Variable.woff2",
          "weight": "200 800",
          "style": "italic"
        },
        {
          "family": "IBM Plex Mono",
          "file": "fonts/IBMPlexMono-Regular.woff2",
          "weight": "400"
        },
        {
