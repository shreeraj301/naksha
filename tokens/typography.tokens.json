{
  "$description": "Four families with one job each. Condensed for display, Archivo for UI, Newsreader for reading, Plex Mono for data.",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Archivo Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    },
    "sans": {
      "$value": [
        "Archivo",
        "system-ui",
        "sans-serif"
      ]
    },
    "serif": {
      "$value": [
        "Newsreader",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    },
    "devanagari": {
      "$value": [
        "Noto Sans Devanagari",
        "sans-serif"
      ],
      "$description": "Proposed (ADR 0005). Devanagari text in any style falls back to this. Not shipped yet."
    }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "extrabold": {
      "$value": 800
    }
  },
  "text": {
    "$type": "typography",
    "display-hero": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 240,
          "unit": "px"
        },
        "fontWeight": "{weight.extrabold}",
        "letterSpacing": {
          "value": -4.8,
          "unit": "px"
        },
        "lineHeight": 0.8
      },
      "$description": "One per page: the name on the home sheet. Caps. Fluid 72px to 304px, the portfolio --t-mega clamp; 240px is the size shown in the artifact.",
      "$extensions": {
        "dev.naksha": {
          "group": "Display",
          "letterSpacingEm": -0.02,
          "sample": "SHEET 00",
          "fluid": "clamp(4.5rem, 0.6rem + 17vw, 19rem)",
          "min": {
            "value": 72,
            "unit": "px"
          }
        }
      }
    },
    "display-xl": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 100,
          "unit": "px"
        },
        "fontWeight": "{weight.extrabold}",
        "letterSpacing": {
          "value": -1.5,
          "unit": "px"
        },
        "lineHeight": 0.85
      },
      "$description": "Section openers. Caps. Fluid 40px to 100px, the portfolio --t-xl clamp.",
      "$extensions": {
        "dev.naksha": {
          "group": "Display",
          "letterSpacingEm": -0.015,
          "sample": "READ",
          "fluid": "clamp(2.5rem, 1.2rem + 5.4vw, 6.25rem)",
          "min": {
            "value": 40,
            "unit": "px"
          }
        }
      }
    },
    "display-l": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": {
          "value": 52,
          "unit": "px"
        },
        "fontWeight": "{weight.extrabold}",
        "letterSpacing": {
          "value": -0.52,
          "unit": "px"
        },
        "lineHeight": 0.9
      },
      "$description": "Case-study titles, cover names. Caps. Fluid 28px to 52px, the portfolio --t-l clamp.",
      "$extensions": {
        "dev.naksha": {
          "group": "Display",
          "letterSpacingEm": -0.01,
          "sample": "FOUND IT",
          "fluid": "clamp(1.75rem, 1.25rem + 2.1vw, 3.25rem)",
          "min": {
            "value": 28,
            "unit": "px"
          }
        }
      }
    },
    "title-l": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "fontWeight": "{weight.semibold}",
        "letterSpacing": {
          "value": -0.8,
          "unit": "px"
        },
        "lineHeight": 1.1
      },
      "$description": "Product page titles. 40px, stepping to 28px below bp.medium (the portfolio has no clamp for this size).",
      "$extensions": {
        "dev.naksha": {
          "group": "Title",
          "letterSpacingEm": -0.02,
          "sample": "Explain this paper",
          "mobile": {
            "value": 28,
            "unit": "px"
          }
        }
      }
    },
    "title-m": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": "{weight.semibold}",
        "letterSpacing": {
          "value": -0.42,
          "unit": "px"
        },
        "lineHeight": 1.15
      },
      "$description": "Modal titles, panel titles. Fluid 20px to 28px, the portfolio --t-m clamp.",
      "$extensions": {
        "dev.naksha": {
          "group": "Title",
          "letterSpacingEm": -0.015,
          "sample": "Agree to this change?",
          "fluid": "clamp(1.25rem, 1.08rem + 0.7vw, 1.75rem)",
          "min": {
            "value": 20,
            "unit": "px"
          }
        }
      }
    },
    "title-s": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 20,
          "unit": "px"
        },
        "fontWeight": "{weight.semibold}",
        "letterSpacing": {
          "value": -0.2,
          "unit": "px"
        },
        "lineHeight": 1.3
      },
