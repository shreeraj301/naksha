      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 17,
          "unit": "px"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": -0.051,
          "unit": "px"
        },
        "lineHeight": 1.55
      },
      "$description": "Reading text and AI answers. Measure 64ch.",
      "$extensions": {
        "dev.naksha": {
          "group": "Text",
          "letterSpacingEm": -0.003,
          "sample": "Architect turned product designer. I design for how people think and decide."
        }
      }
    },
    "body-m": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": 0.0,
          "unit": "px"
        },
        "lineHeight": 1.5
