  "$extensions": {
    "dev.naksha": {
      "fontFiles": [
        {
          "family": "Archivo",
          "file": "fonts/Archivo-Variable.woff2",
          "weight": "100 900"
        },
        {
          "family": "Archivo Condensed",
          "file": "fonts/ArchivoCondensed-Variable.woff2",
