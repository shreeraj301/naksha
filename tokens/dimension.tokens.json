  "radius": {
    "$type": "dimension",
    "$description": "Square by decision: the drawing-sheet edge. The scale exists so a product can soften later by changing radius-control and radius-surface only.",
    "control": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "Buttons, fields, tags, segmented controls."
    },
    "surface": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "Cards, menus, modals, toasts, alerts."
    },
    "round": {
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$description": "Only where a circle means something: radio, people avatars, status dots, spinner."
    },
