{
  "name": "naksha",
  "version": "0.2.2",
  "description": "Naksha, the design system of Shreeraj Narwade. Tokens, components and patterns drawn like a set of architectural sheets.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Shreeraj Narwade",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeraj301/naksha.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./tokens": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/naksha.css",
    "./css/components": "./dist/css/components.css",
    "./css/custom-media": "./dist/css/custom-media.css",
    ".": {
      "types": "./dist/js/naksha.d.ts",
      "default": "./dist/js/naksha.js"
    }
  },
  "files": [
    "dist",
    "fonts/licenses",
    "scripts/cli.mjs",
    "scripts/skill.mjs",
    "scripts/tokens.mjs",
    "tokens",
    "artifact",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/icons.mjs --check && node scripts/build.mjs && node scripts/bundle.mjs && node scripts/skill.mjs",
    "prepare": "node scripts/build.mjs && node scripts/bundle.mjs && node scripts/skill.mjs",
    "test": "npm run build && node --test \"tests/*.test.mjs\" && vitest run",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "stylelint \"css/**/*.css\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:skill && npm run test:visual",
    "check:skill": "node scripts/skill.mjs --check"
  },
  "devDependencies": {
    "stylelint": "^16.26.1",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "vitest": "5.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/dom": "10.4.2",
    "jsdom": "30.1.3",
    "axe-core": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "bin": {
    "naksha": "scripts/cli.mjs"
  }
}
